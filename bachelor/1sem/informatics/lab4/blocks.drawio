        </mxCell>
        <mxCell id="left_loop" value="for (i = 0; i &lt; n; i++)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="690" width="210" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="left_index" value="index = (k - i + n) % n" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">

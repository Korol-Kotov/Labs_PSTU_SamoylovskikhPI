        <mxCell id="append_last" value="Добавить три последних&lt;br&gt;элемента исходного массива:&lt;br&gt;arr[n+1] = arr[n-3]&lt;br&gt;arr[n+2] = arr[n-2]&lt;br&gt;arr[n+3] = arr[n-1]" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
